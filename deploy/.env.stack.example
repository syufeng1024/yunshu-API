# 全栈部署的环境模板。复制为 deploy/.env.stack 后使用：
#
#   cp deploy/.env.stack.example deploy/.env.stack
#   docker compose --env-file deploy/.env.stack -f deploy/docker-compose.stack.yml up -d --build
#
# deploy/.env.stack 已被 .gitignore 排除，不会入库。
# 下面每一项在非本地环境都必须换掉——注释里标了「dev only」的值只服务于
# 本地跑通，直接拿去上线等于把数据库敞开。

# 进程环境标签，写进每一行日志：local | dev | staging | prod
#
# 这个值不只是日志标签，它决定迁移 0019（本地联调种子）跑不跑：
#   ENV=local → 应用 0019：1 条占位渠道 + 2 个文本模型 + 2 条路由 + 2 条价目规则
#   其它值    → 跳过 0019 并打 WARN，且**不记入 schema_migrations**，
#               后续把 ENV 改成 local 再跑一次 migrate 仍会补上
# 生产必须是 prod（或 staging），否则会把占位渠道和假价目写进正式库。
ENV=prod

# 对外端口。宿主 3306/6379 已被本机服务占用，所以存储层干脆不发布端口，
# 这里只有三个入口端口，改了就要同步改 README。
WEB_PORT=8088
GATEWAY_PORT=18080
CONTROL_PORT=18081

# ============================================================================
#  ⚠️  生产部署前必须先改这里，改完再 up
# ============================================================================
#
# MySQL root 口令。当前值 `root` 是本地跑通用的占位口令，**没有任何强度**，
# 而容器内的 DSN 默认就用 root 连库——也就是说这个值既是 MySQL 的 root 口令，
# 也是应用的数据库账号口令，一旦泄漏等于整库沦陷。
#
# 生产环境必须做两件事，缺一不可：
#
#   1. 换掉这个口令，并且不要写在这个文件里。
#      推荐由密钥管理（Vault / KMS / K8s Secret / 云厂商参数仓库）在部署时
#      以环境变量注入，本文件只保留一个空的占位或者干脆不写这一行。
#      直接写在 deploy/.env.stack 里的明文口令，等于把库密码留在磁盘上。
#
#   2. 不要用 root 跑应用。新建一个受限账号，只授予 yunshu / yunshu_log
#      两个 schema 的 DML + DDL 权限（迁移需要 DDL），然后通过下面的
#      DB_DSN / LOG_SQL_DSN / GW_WRITE_DSN 显式指向它。
#
#      参考（在 MySQL 里执行，口令不要和 root 相同）：
#
#        CREATE USER 'yunshu_app'@'%' IDENTIFIED BY '<强口令>';
#        GRANT ALL PRIVILEGES ON `yunshu`.*     TO 'yunshu_app'@'%';
#        GRANT ALL PRIVILEGES ON `yunshu_log`.* TO 'yunshu_app'@'%';
#        FLUSH PRIVILEGES;
#
#      然后把三个 DSN 都改成：
#
#        DB_DSN='yunshu_app:<强口令>@tcp(mysql:3306)/yunshu?parseTime=true&loc=UTC&charset=utf8mb4'
#
# 注意 GRANT ALL 里包含 DDL：migrate 要建表改表，只给 DML 会让迁移失败。
# 如果希望迁移用高权限账号、运行期用低权限账号，就分开两份凭据分别注入。
# ============================================================================
MYSQL_ROOT_PASSWORD=root

# DSN 留空则按 MYSQL_ROOT_PASSWORD 自动拼出容器内地址（mysql:3306）。
# 生产环境把这三项都显式写上，指向上面创建的受限账号，不要依赖默认值。
# 只有填写了才生效；留空 = 回退到 root。
DB_DSN=
LOG_SQL_DSN=
GW_WRITE_DSN=

REDIS_ADDR=
REDIS_PASSWORD=

# Cookie / 会话签名密钥。必填，缺失时 compose 直接拒绝启动。
# 生成：openssl rand -base64 32
SESSION_SECRET=

# 上游密钥信封 KEK，base64 的 32 字节（AES-256-GCM）。
# 留空不阻塞启动，但每一次上游分发都会返回 503 config_unavailable——
# 这是刻意的：没有明文回退。
# 生成：openssl rand -base64 32
CHANNEL_KEY_KEK=

# 请求正文加密 KEK（`log.body_mode=opt_in` 时写入 t_request_body 的密文），
# base64 的 32 字节。独立于 CHANNEL_KEY_KEK：轮换渠道密钥不得使历史正文失效。
# 留空 = 正文功能关闭：进程照常启动、请求与账务不受影响，正文不落库并记
# gw_log_body_dropped_total{reason="no_kek"}；读取端对已存正文返回 404 并记
# gw_log_body_open_failed_total。gatewayd 与 controld 必须配置同一值。
# 生成：openssl rand -base64 32
LOG_BODY_KEK=

# 体验版设备指纹 HMAC 密钥（任意非空随机串）。
# 留空不阻塞启动，但 /api/console/trial/claim 会返回 503 config_unavailable。
# 生成：openssl rand -base64 32
FP_HMAC_KEY=

# 网关 metrics（容器内 :9090）目前不发布到宿主；需要抓取时再加端口映射，
# 且必须同时设 token，否则等于把运行指标公开。
GATEWAY_METRICS_TOKEN=

GATEWAY_DB_MAX_CONNS=8

# 构建期镜像名后缀与 npm 源。
IMAGE_TAG=local
NPM_REGISTRY=https://registry.npmmirror.com

# 用量 CSV 导出目录与 HMAC 签名密钥。目录默认容器 /tmp/yunshu-exports；
# 令牌 1 小时后失效，不需要持久卷。EXPORT_HMAC_KEY 留空时导出接口返回
# 503 config_unavailable，绝不退化为无签名链接。
EXPORT_DIR=/tmp/yunshu-exports
EXPORT_HMAC_KEY=
