# Local development template. Copy to .env and change every credential before
# any shared or production environment. .env is git-ignored.
#
# The values below are the compose defaults from deploy/docker-compose.yml and
# are not valid production secrets.

# Process environment label written to every log line: dev | staging | prod.
ENV=dev

# Control-plane / jobs main database (read-write).
# The schema collation is utf8mb4_0900_as_cs (set by deploy/mysql/init). Do not
# add collation= to the DSN: go-sql-driver only whitelists a subset of
# collations, and column comparisons already use the schema collation.
# Keep the single quotes: make run-* sources this file with sh, and the DSN
# contains & characters.
DB_DSN='root:root@tcp(127.0.0.1:3306)/yunshu?parseTime=true&loc=UTC&charset=utf8mb4'

# Log database (same MySQL instance, separate schema in V1.0).
LOG_SQL_DSN='root:root@tcp(127.0.0.1:3306)/yunshu_log?parseTime=true&loc=UTC&charset=utf8mb4'

# The gateway's only main-database channel. It is capped by
# GATEWAY_DB_MAX_CONNS and must never become a general-purpose pool.
GW_WRITE_DSN='root:root@tcp(127.0.0.1:3306)/yunshu?parseTime=true&loc=UTC&charset=utf8mb4'

# Redis. Leave REDIS_PASSWORD empty for the local compose service.
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# HTTP listeners. Defaults are :8080 (gateway) and :8081 (control plane).
# Override when the host already uses those ports (this machine: 8080 is taken
# by another project's container, so local .env sets :8082).
GATEWAY_HTTP_ADDR=:8080
CONTROL_HTTP_ADDR=:8081

# Gateway metrics listener, isolated from :8080. When the token is empty the
# endpoint has no authentication and must stay on an internal interface.
GATEWAY_METRICS_ADDR=:9090
GATEWAY_METRICS_TOKEN=

# Gateway main-database channel size. Default 8; must be >= 1.
GATEWAY_DB_MAX_CONNS=8

# Cookie/session signing key. Replace before any non-local deployment.
SESSION_SECRET=dev-only-session-secret-change-before-deploy
