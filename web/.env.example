# Copy to .env.local before running `npm run dev`.
# The Vite dev server proxies /api, /healthz and /readyz to this origin.
VITE_DEV_API_TARGET=http://localhost:8081

# Optional direct control-plane origin for deployed builds. Leave empty when the
# site and control plane share an origin (recommended). Do not append /api/v1.
VITE_API_BASE_URL=
